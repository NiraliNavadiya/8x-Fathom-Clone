# Never commit real values. Locally, `neon deploy` / `neon env pull` writes the
# Neon variables below into .env.local. On Vercel, set them in Project Settings >
# Environment Variables.

# Neon Postgres
# Pooled connection string, used by the app at runtime.
DATABASE_URL=
# Direct (unpooled) connection string, used by Prisma migrations.
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Neon Object Storage (bucket names are declared in neon.ts).
# Endpoint is per branch, e.g. https://br-xxxx.storage.c-1.us-east-2.aws.neon.tech
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Anthropic API key for AI summaries and Ask Meetly.
ANTHROPIC_API_KEY=
